# Local SQLite database (Turso also accepts a remote libsql:// URL).
TURSO_DATABASE_URL=file:./lcps-local.db
# TURSO_AUTH_TOKEN=YOUR_TURSO_DATABASE_TOKEN
FILE_STORAGE_MODE=local

# Required only for the first administrator setup. Generate a private random key.
ADMIN_SETUP_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARACTERS

# For private Vercel Blob storage instead of local files:
# FILE_STORAGE_MODE=blob
# BLOB_READ_WRITE_TOKEN=YOUR_PRIVATE_VERCEL_BLOB_TOKEN
