{
  "name": "lcps-lms-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "check": "npm run typecheck && npm test",
    "setup-key": "node scripts/setup-key.mjs",
    "db:migrate": "node scripts/migrate-sqlite.mjs",
    "db:import:dry-run": "node scripts/migrate-turso-to-postgres.mjs --dry-run",
    "db:import": "node scripts/migrate-turso-to-postgres.mjs --apply",
    "db:files:dry-run": "node scripts/migrate-legacy-files-to-blob.mjs --dry-run",
    "db:files:migrate": "node scripts/migrate-legacy-files-to-blob.mjs --apply"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@vercel/blob": "2.8.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.27.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
